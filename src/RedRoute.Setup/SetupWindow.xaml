<Window x:Class="RedRoute.Setup.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Установка RED_ROUTE" Width="620" Height="460" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI" FontSize="14" Closing="Closing_Window" WindowStyle="None" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <DockPanel LastChildFill="True"><Border DockPanel.Dock="Top" Height="32" Background="{DynamicResource BackgroundBrush}"><Grid><TextBlock x:Name="CaptionTitle" Text="Установка RED_ROUTE" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><Button HorizontalAlignment="Right" Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="TitleClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Закрыть"/></Grid></Border>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,22"><Grid><TextBlock Text="RED_ROUTE" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="16"/><TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></Grid></Border>
  <StackPanel Grid.Row="1" Margin="30,26"><TextBlock x:Name="Heading" Text="Установка VPN-клиента" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Description" Text="Установим RED_ROUTE и службу подключения. Все необходимые компоненты уже включены." Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0"/>
   <StackPanel x:Name="ProgressArea" Margin="0,30,0,0" Visibility="Collapsed"><Grid><TextBlock x:Name="PhaseText" Text="Подготавливаем установку…"/><TextBlock x:Name="PercentText" HorizontalAlignment="Right" Text="0 %" Foreground="{DynamicResource MutedBrush}"/></Grid><ProgressBar x:Name="Progress" Height="6" Margin="0,13,0,0" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" BorderThickness="0"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/></Grid></Grid></ControlTemplate></ProgressBar.Template></ProgressBar></StackPanel>
   <CheckBox x:Name="LaunchCheck" Content="Открыть RED_ROUTE" IsChecked="True" Visibility="Collapsed" Margin="0,24,0,0"/>
   <TextBlock x:Name="Note" Text="После установки добавьте файл .conf на вкладке «Профили»." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,26,0,0"/>
  </StackPanel>
  <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,18"><Grid><Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" HorizontalAlignment="Left" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource InkBrush}"/><Button x:Name="MainButton" Content="Установить" Click="Main_Click" HorizontalAlignment="Right" IsDefault="True"/></Grid></Border>
 </Grid>
</DockPanel></Window>
