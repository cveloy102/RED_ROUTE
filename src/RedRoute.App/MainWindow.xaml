<Window x:Class="RedRoute.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RED_ROUTE" Width="760" Height="850" MinWidth="660" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="Window_Closing" WindowStyle="None" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <DockPanel LastChildFill="True"><Border DockPanel.Dock="Top" Height="32" Background="#101010"><Grid><TextBlock Text="RED_ROUTE" Margin="14,0" VerticalAlignment="Center" Foreground="#AAA79F" FontSize="12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="TitleMin_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Свернуть"/><Button Style="{StaticResource TitleButton}" Content="&#xE922;" Click="TitleMax_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Развернуть или восстановить"/><Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="TitleClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Закрыть"/></StackPanel></Grid></Border>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="28,24,28,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RED_ROUTE / ЛИЧНЫЙ VPN" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="12"/><TextBlock Margin="0,8,0,0" FontSize="26" FontWeight="SemiBold">Интернет под контролем<Run Foreground="{StaticResource AccentBrush}">_</Run></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="0.1.3" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top"/></Grid>
  <Border Grid.Row="1" BorderBrush="#353535" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" Margin="28,0"><Button x:Name="HomeTab" Content="Главная" Click="Home_Click" BorderThickness="0" Margin="0,0,10,8"/><Button x:Name="ProfilesTab" Content="Профили" Click="Profiles_Click" Margin="0,0,10,8"/><Button x:Name="HelpTab" Content="Помощь" Click="Help_Click" Margin="0,0,0,8"/></StackPanel></Border>
  <ScrollViewer x:Name="MainScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="28,22">
   <StackPanel x:Name="HomePage">
    <UniformGrid Columns="3" Margin="0,0,-8,0">
     <Button x:Name="OnButton" Click="On_Click" Margin="0,0,8,0" HorizontalContentAlignment="Left" AutomationProperties.Name="Вкл. Все сайты и приложения через VPN"><StackPanel><TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="21" Margin="0,0,0,10"/><TextBlock Text="Вкл" FontFamily="Consolas" FontSize="20"/><TextBlock Text="Все сайты и приложения через VPN" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontSize="13" MinHeight="40"/></StackPanel></Button>
     <Button x:Name="OffButton" Click="Off_Click" Margin="0,0,8,0" HorizontalContentAlignment="Left" AutomationProperties.Name="Выкл. VPN выключен. Интернет напрямую"><StackPanel><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="21" Margin="0,0,0,10"/><TextBlock Text="Выкл" FontFamily="Consolas" FontSize="20"/><TextBlock Text="VPN выключен. Интернет напрямую" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontSize="13" MinHeight="40"/></StackPanel></Button>
     <Button x:Name="AutoButton" Click="Auto_Click" Margin="0,0,8,0" HorizontalContentAlignment="Left" AutomationProperties.Name="Авто. Через VPN только из списка. Остальное напрямую"><StackPanel><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="21" Margin="0,0,0,10"/><TextBlock Text="Авто" FontFamily="Consolas" FontSize="20"/><TextBlock Text="Через VPN — только из списка. Остальное напрямую" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontSize="13" MinHeight="40"/></StackPanel></Button>
    </UniformGrid>
    <Border BorderBrush="#353535" BorderThickness="0,0,0,1" Padding="0,20"><StackPanel><TextBlock x:Name="StatusTitle" Text="VPN выключен" FontWeight="SemiBold" FontSize="15" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StatusDetail" Text="Интернет работает напрямую." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/></StackPanel></Border>
    <TextBlock Text="Через VPN в режиме Авто" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,14"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DomainInput" AutomationProperties.Name="Домен или ссылка на сайт" ToolTip="Введите домен или вставьте ссылку, например youtube.com" KeyDown="Domain_KeyDown"/><Button Grid.Column="1" Content="+ Добавить" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddSite_Click"/></Grid>
    <TextBlock Text="Введите сайт или вставьте ссылку. Адреса и обновления берём на себя." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,9,0,16"/>
    <TextBlock x:Name="EmptySites" Text="Пока ничего не добавлено. Например, добавьте youtube.com." Foreground="{StaticResource MutedBrush}" Margin="0,15"/>
    <ItemsControl x:Name="SiteItems"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#353535" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="Удалить" Click="RemoveSite_Click" FontSize="12"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DatabaseText" Text="База сервисов обновляется автоматически" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Расширенный режим" FontSize="12" Click="Advanced_Click"/></Grid>
    <Border x:Name="AdvancedPanel" Visibility="Collapsed" Background="{StaticResource PanelBrush}" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="База сервисов и маршрутизация" FontWeight="SemiBold"/><TextBlock Text="Домен включает поддомены. Сервисы используют списки Geo-Aggregator. При защищённом DNS браузера скрытые имена могут не распознаться; используйте обычный DNS браузера или IP-правила." Foreground="{StaticResource MutedBrush}" Margin="0,10"/><WrapPanel><Button Content="Обновить базу" Click="RefreshCatalog_Click" Margin="0,0,8,8"/><Button Content="Добавить IP / подсеть" Click="AddIp_Click" Margin="0,0,8,8"/><Button Content="Экспорт правил" Click="ExportRules_Click" Margin="0,0,8,8"/><Button Content="Импорт правил" Click="ImportRules_Click" Margin="0,0,8,8"/></WrapPanel><CheckBox x:Name="StartupCheck" Content="Запускать RED_ROUTE при входе в Windows" Click="Startup_Click"/></StackPanel></Border>
   </StackPanel>
   <StackPanel x:Name="ProfilesPage" Visibility="Collapsed"><TextBlock Text="Профили подключения" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Начинаем с основного. Если связь пропала — пробуем резервные по порядку." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,22"/><ItemsControl x:Name="ProfileItems"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#353535" BorderThickness="0,0,0,1" Padding="0,16"><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,12"/><WrapPanel><Button Content="Сделать главным" Click="MakePrimary_Click" FontSize="12" Margin="0,0,8,6"/><Button Content="Выше" Click="MoveUp_Click" FontSize="12" Margin="0,0,8,6"/><Button Content="Ниже" Click="MoveDown_Click" FontSize="12" Margin="0,0,8,6"/><Button Content="Переименовать" Click="RenameProfile_Click" FontSize="12" Margin="0,0,8,6"/><Button Content="Удалить" Click="RemoveProfile_Click" FontSize="12" Margin="0,0,0,6"/></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="+ Добавить файл .conf" Click="ImportProfile_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,16"/><CheckBox x:Name="FailoverCheck" Content="Переключаться на резервный при потере связи" Click="Failover_Click"/><TextBlock Text="Если все профили недоступны, интернет работает напрямую. Подключение повторяется автоматически. С рабочего резерва на основной возвращаемся при следующем включении VPN." Foreground="{StaticResource MutedBrush}" Margin="0,10"/></StackPanel>
   <StackPanel x:Name="HelpPage" Visibility="Collapsed"><TextBlock Text="Помощь с подключением" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Проверка открывает HTTPS через сам VPN, а не просто проверяет, запущен ли туннель." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,20"/><WrapPanel><Button Content="Проверить подключение" Style="{StaticResource PrimaryButton}" Click="Check_Click" Margin="0,0,10,10"/><Button Content="Сохранить отчёт" Click="SaveReport_Click" Margin="0,0,0,10"/></WrapPanel><TextBlock x:Name="DiagnosticText" Foreground="{StaticResource MutedBrush}" Margin="0,16"/><TextBlock Text="Последние события" FontSize="17" Margin="0,10"/><TextBox x:Name="EventsBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="200" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/><TextBlock Text="Пароли, ключи, содержимое .conf и история посещений не включаются в отчёт." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,14"/></StackPanel>
  </Grid></ScrollViewer>
  <Border Grid.Row="3" BorderBrush="#353535" BorderThickness="0,1,0,0" Padding="28,16"><StackPanel><TextBlock x:Name="Feedback" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/><Button Click="Recover_Click" Background="Transparent" BorderBrush="Transparent" Padding="0" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="↪  Восстановить обычный интернет" FontWeight="SemiBold"/><TextBlock Text="Выключить VPN и отменить его изменения сети" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="20,5,0,0"/></StackPanel></Button></StackPanel></Border>
 </Grid>
</DockPanel></Window>
