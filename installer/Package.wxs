<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
 <Package Name="RED_ROUTE" Manufacturer="RED_ROUTE" Version="$(var.ProductVersion)" UpgradeCode="74D7C06B-A26A-4411-A111-92760468AA21" Scope="perMachine" Compressed="yes" Language="1049" Codepage="1251">
  <SummaryInformation Description="RED_ROUTE — VPN-клиент для Windows 10 и 11"/>
  <MajorUpgrade DowngradeErrorMessage="Уже установлена более новая версия RED_ROUTE." Schedule="afterInstallInitialize"/>
  <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
  <Icon Id="RedRouteIcon" SourceFile="..\src\RedRoute.App\Assets\RedRoute.ico"/><Property Id="ARPPRODUCTICON" Value="RedRouteIcon"/>
  <Property Id="LAUNCHREDROUTE" Value="1"/>
  <Property Id="REDROUTEOWNER" Secure="yes"><RegistrySearch Id="ExistingOwner" Root="HKLM" Key="SOFTWARE\RED_ROUTE" Name="OwnerSid" Type="raw" Bitness="always64"/></Property>
  <SetProperty Id="REDROUTEOWNER" Value="[UserSID]" After="AppSearch" Sequence="both" Condition="NOT REDROUTEOWNER"/>
  <EnsureTable Id="ControlCondition"/>
  <CustomAction Id="OpenRedRoute" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]RED_ROUTE.exe&quot;" Execute="immediate" Impersonate="yes" Return="asyncNoWait"/>
  <UI>
   <UIRef Id="WixUI_Common"/>
   <DialogRef Id="ErrorDlg"/><DialogRef Id="FilesInUse"/><DialogRef Id="MsiRMFilesInUse"/><DialogRef Id="FatalError"/><DialogRef Id="UserExit"/>
   <TextStyle Id="InstallerNormal" FaceName="Segoe UI" Size="10"/>
   <TextStyle Id="InstallerTitle" FaceName="Segoe UI" Size="18" Bold="yes"/>
   <TextStyle Id="InstallerBrand" FaceName="Consolas" Size="11" Red="240" Green="68" Blue="62"/>
   <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9"/><TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="10" Bold="yes"/><TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12"/>
   <Property Id="DefaultUIFont" Value="InstallerNormal"/>
   <Dialog Id="RedRouteWelcome" Width="400" Height="255" Title="Установка RED_ROUTE" NoMinimize="yes">
    <Control Id="Brand" Type="Text" X="24" Y="20" Width="350" Height="20" Text="{\InstallerBrand}RED_ROUTE"/>
    <Control Id="Heading" Type="Text" X="24" Y="56" Width="350" Height="48" Text="{\InstallerTitle}Установка VPN-клиента"/>
    <Control Id="Description" Type="Text" X="24" Y="116" Width="350" Height="48" Text="Установим RED_ROUTE и службу подключения. После завершения можно будет добавить файл .conf с настройками VPN."/>
    <Control Id="Permissions" Type="Text" X="24" Y="175" Width="350" Height="28" Text="Для установки нужны права администратора. Windows может запросить подтверждение."/>
    <Control Id="Install" Type="PushButton" X="210" Y="221" Width="80" Height="22" Default="yes" ElevationShield="yes" Text="Установить"><Publish Event="EndDialog" Value="Return"/></Control>
    <Control Id="Cancel" Type="PushButton" X="300" Y="221" Width="76" Height="22" Cancel="yes" Text="Отмена"><Publish Event="EndDialog" Value="Exit"/></Control>
   </Dialog>
   <Dialog Id="RedRouteSuccess" Width="400" Height="255" Title="RED_ROUTE установлен" NoMinimize="yes">
    <Control Id="Brand" Type="Text" X="24" Y="20" Width="350" Height="20" Text="{\InstallerBrand}RED_ROUTE"/>
    <Control Id="Heading" Type="Text" X="24" Y="56" Width="350" Height="48" Text="{\InstallerTitle}Установка завершена"/>
    <Control Id="Description" Type="Text" X="24" Y="114" Width="350" Height="44" Text="RED_ROUTE готов к работе. Откройте программу и добавьте файл .conf на вкладке «Профили»."/>
    <Control Id="Launch" Type="CheckBox" X="24" Y="174" Width="350" Height="22" Property="LAUNCHREDROUTE" CheckBoxValue="1" Text="Открыть RED_ROUTE после установки"/>
    <Control Id="Finish" Type="PushButton" X="280" Y="221" Width="96" Height="22" Default="yes" Cancel="yes" Text="Готово"><Publish Event="DoAction" Value="OpenRedRoute" Order="1" Condition="LAUNCHREDROUTE = 1"/><Publish Event="EndDialog" Value="Return" Order="2"/></Control>
   </Dialog>
   <InstallUISequence>
    <Show Dialog="RedRouteWelcome" Before="ExecuteAction" Condition="NOT Installed"/>
    <Show Dialog="RedRouteSuccess" OnExit="success" Condition="NOT (REMOVE ~= &quot;ALL&quot;)"/>
   </InstallUISequence>
   <AdminUISequence><Show Dialog="RedRouteSuccess" OnExit="success"/></AdminUISequence>
  </UI>
  <Launch Condition="VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 19045" Message="Нужна Windows 10 22H2 или Windows 11 (64-разрядная)."/>
  <Property Id="WINDOWSBUILDNUMBER"><RegistrySearch Id="WindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64"/></Property>
  <StandardDirectory Id="ProgramFiles64Folder"><Directory Id="INSTALLFOLDER" Name="RED_ROUTE">
   <Directory Id="SERVICEFOLDER" Name="service">
    <Component Id="VpnService" Bitness="always64" Guid="611C723B-EC49-46C5-8E0B-5C90F0EE6F8A">
     <File Id="ServiceExe" Source="$(var.PublishDir)\service\RED_ROUTE.Service.exe" KeyPath="yes"/>
     <ServiceInstall Id="InstallService" Name="RED_ROUTE" DisplayName="RED_ROUTE VPN" Description="VPN, маршрутизация сайтов и резервные профили RED_ROUTE" Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem">
      <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart" ResetPeriodInDays="1" RestartServiceDelayInSeconds="5"/>
     </ServiceInstall>
     <ServiceControl Id="ControlService" Name="RED_ROUTE" Start="install" Stop="both" Remove="uninstall" Wait="yes"/>
    </Component>
   </Directory>
   <Component Id="OwnerRegistration" Bitness="always64" Guid="A899A48F-3B6C-47D3-9C84-A809F95B6002">
    <RegistryValue Root="HKLM" Key="SOFTWARE\RED_ROUTE" Name="OwnerSid" Type="string" Value="[REDROUTEOWNER]" KeyPath="yes"/>
    <RegistryValue Root="HKLM" Key="SOFTWARE\RED_ROUTE" Name="InstallDirectory" Type="string" Value="[INSTALLFOLDER]"/>
   </Component>
  </Directory></StandardDirectory>
  <StandardDirectory Id="ProgramMenuFolder"><Directory Id="MenuFolder" Name="RED_ROUTE"><Component Id="StartMenu" Guid="867B4F51-B508-42D3-9EA8-27419EC25272">
   <Shortcut Id="LaunchShortcut" Name="RED_ROUTE" Target="[INSTALLFOLDER]RED_ROUTE.exe" WorkingDirectory="INSTALLFOLDER"/>
   <Shortcut Id="RecoverShortcut" Name="RED_ROUTE — восстановить интернет" Target="[INSTALLFOLDER]RED_ROUTE.exe" Arguments="--recover" WorkingDirectory="INSTALLFOLDER"/>
   <RemoveFolder Id="RemoveMenuFolder" On="uninstall"/>
   <RegistryValue Root="HKCU" Key="SOFTWARE\RED_ROUTE" Name="StartMenu" Value="1" Type="integer" KeyPath="yes"/>
  </Component></Directory></StandardDirectory>
  <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER"><Files Include="$(var.PublishDir)\**"><Exclude Files="$(var.PublishDir)\service\RED_ROUTE.Service.exe"/><Exclude Files="$(var.PublishDir)\**\*.pdb"/></Files></ComponentGroup>
  <Feature Id="MainFeature" Title="RED_ROUTE" Level="1"><ComponentGroupRef Id="ApplicationFiles"/><ComponentRef Id="VpnService"/><ComponentRef Id="OwnerRegistration"/><ComponentRef Id="StartMenu"/></Feature>
 </Package>
</Wix>
